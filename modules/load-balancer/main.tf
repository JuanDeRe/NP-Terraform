  }
}

resource "aws_lb_target_group" "matchmaking" {
  name = "${var.project_name}-${var.environment}-mm"

  port        = 8080
  protocol    = "HTTP"
  target_type = "instance"
  vpc_id      = var.vpc_id

  health_check {
    enabled             = true
    path                = "/health"
    healthy_threshold   = 2
